# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/

# Generated by XcodeGen (regenerate with `xcodegen generate`)
*.xcodeproj

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Release artefacts, built by tools/build-deb.sh or downloaded from a release.
# They are tens of megabytes and must never land in a commit.
*.deb
*.tar.gz
Mediafin.app.zip
dist/

# Screenshots the GTK job renders, pulled down to look at. Regenerated on
# every build, so keeping them would only add weight and go stale.
gtk-window.png
window.png

# Python bytecode from the checks in tools/.
__pycache__/
*.pyc

# Artefacts the CI steps write into the working copy.
#
# tools/replay-ci-step.py runs those steps HERE, and they drop their logs
# and screenshots in the repository root exactly as they do on a runner.
# Eighteen of them were committed by a careless `git add -A` and sat there
# for three commits: build output, checked in, read by nothing. Ignored at
# the root only, so docs/logo.png and packaging/icons/** stay tracked.
/*.log
/*.png
